{
  "name": "alfa-only-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ИИ-ассистент персонального менеджера Alfa Only — демонстрационный прототип рабочего места.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "export-seed": "esbuild scripts/export-seed.ts --bundle --format=esm --platform=node --log-level=error | node --input-type=module > backend/app/seed/seed.json",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
